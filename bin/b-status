#!/bin/sh

# Show each project's current branch and whether it has uncommitted changes.
case $0 in
    */*) script=$0 ;;
    *) script=$(command -v -- "$0") || exit 1 ;;
esac
script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd) || exit 1
lib=$script_dir/../lib
. "$lib/projects.sh"
. "$lib/print-table.sh"

for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    [ -d "$project" ] || continue
    branch='(not a Git repository)'
    dirty=x
    # Require the child's own Git metadata; never discover the enclosing repo.
    if [ -e "$project/.git" ] &&
        git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
        if branch_name=$(git -C "$project" symbolic-ref --quiet --short HEAD 2>/dev/null); then
            branch=$branch_name
        elif commit=$(git -C "$project" rev-parse --short HEAD 2>/dev/null); then
            branch="(detached at $commit)"
        else
            branch='(HEAD unavailable)'
        fi
        if porcelain=$(git -C "$project" status --porcelain 2>/dev/null) &&
            [ -z "$porcelain" ]; then
            dirty=
        fi
    fi
    printf '%s\t%s\t%s\n' "${project##*/}" "$branch" "$dirty"
done | sort -t "$(printf '\t')" -k1,1 | print_table PROJECT BRANCH DIRTY
