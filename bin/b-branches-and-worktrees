#!/bin/sh

# List each project's local branches other than its default branch,
# its remote-tracking branches other than that default, then its linked
# worktrees.
case $0 in
    */*) script=$0 ;;
    *) script=$(command -v -- "$0") || exit 1 ;;
esac
script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd) || exit 1
lib=$script_dir/../lib
. "$lib/projects.sh"
. "$lib/is-project.sh"
. "$lib/set-default.sh"
. "$lib/local-branches.sh"
. "$lib/remote-branches.sh"
. "$lib/linked-worktrees.sh"
. "$lib/print-table.sh"

tab=$(printf '\t')
projects_dir=$(CDPATH= cd -P -- "$projects_link" && pwd -P) || exit 1

# Prefix each line of stdin with the project name and a tab.
with_name() {
    while IFS= read -r line; do
        printf '%s\t%s\n' "$name" "$line"
    done
}

# Print worktree path $1 relative to the projects directory, or to ~.
short_path() {
    case $1 in
        "$projects_dir"/*)
            printf '%s\n' "${1#"$projects_dir"/}"
            return
            ;;
    esac
    if [ -n "$HOME" ]; then
        case $1 in
            "$HOME"/*)
                printf '~/%s\n' "${1#"$HOME"/}"
                return
                ;;
        esac
    fi
    printf '%s\n' "$1"
}

printf 'NON-MAIN BRANCHES\n'
for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    is_project "$project" || continue
    set_default
    local_branches | with_name
done | sort -t "$tab" -k1,1 -k2,2 | print_table PROJECT BRANCH

printf '\nREMOTE-TRACKING BRANCHES\n'
for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    is_project "$project" || continue
    set_default
    remote_branches | with_name
done | sort -t "$tab" -k1,1 -k2,2 | print_table PROJECT BRANCH

printf '\nNON-MAIN WORKTREES\n'
for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    is_project "$project" || continue
    if ! worktrees=$(linked_worktrees); then
        printf '%s: unable to list worktrees\n' "$name" >&2
        continue
    fi
    # Number each worktree so sorting keeps Git's order within a project.
    n=0
    while IFS="$tab" read -r wt branch; do
        [ -n "$wt" ] || continue
        n=$((n + 1))
        printf '%s\t%s\t%s\t%s\n' "$name" "$n" "$branch" "$(short_path "$wt")"
    done <<EOF
$worktrees
EOF
done | sort -t "$tab" -k1,1 -k2,2n | cut -f1,3,4 | print_table PROJECT BRANCH FOLDER
