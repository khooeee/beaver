#!/bin/sh

# Show leftover non-default branches, remote-tracking branches, and linked
# worktrees, then delete them after the user types y.
case $0 in
    */*) script=$0 ;;
    *) script=$(command -v -- "$0") || exit 1 ;;
esac
script_dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd) || exit 1
lib=$script_dir/../lib
. "$lib/projects.sh"
. "$lib/is-project.sh"
. "$lib/set-default.sh"
. "$lib/local-branches.sh"
. "$lib/remote-branches.sh"
. "$lib/linked-worktrees.sh"
. "$lib/remove-worktree.sh"

"$script_dir/b-branches-and-worktrees" || exit $?

tab=$(printf '\t')

# Succeed when any project has a branch or worktree to clean up.
has_leftovers() {
    for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
        is_project "$project" || continue
        set_default
        [ -n "$(local_branches)" ] && return 0
        [ -n "$(linked_worktrees)" ] && return 0
        [ -n "$(remote_branches)" ] && return 0
    done
    return 1
}

if ! has_leftovers; then
    printf 'Nothing to clean up.\n'
    exit 0
fi

if [ ! -t 0 ]; then
    printf 'Refusing to clean up without a terminal. Type y to confirm.\n' >&2
    exit 1
fi

printf '\nType Y and press Enter to delete the local branches, remote-tracking branches, and worktrees above: ' >&2
IFS= read -r answer || exit 1
answer=$(printf '%s' "$answer" | tr -d '\r')
case $answer in
    [yY]) ;;
    *)
        printf 'Aborted.\n'
        exit 1
        ;;
esac

removed_wt=0
removed_br=0
removed_remote=0
failed=0

for project in "$projects_link"/* "$projects_link"/.[!.]* "$projects_link"/..?*; do
    is_project "$project" || continue

    if worktrees=$(linked_worktrees); then
        while IFS="$tab" read -r wt _; do
            [ -n "$wt" ] || continue
            remove_worktree
        done <<EOF
$worktrees
EOF
    fi

    set_default
    current=$(git -C "$project" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
    while IFS= read -r branch; do
        [ -n "$branch" ] || continue
        if [ -n "$current" ] && [ "$branch" = "$current" ]; then
            if [ -z "$default" ]; then
                printf '%s: skip %s (checked out; no default branch)\n' \
                    "$name" "$branch" >&2
                failed=$((failed + 1))
                continue
            fi
            if ! git -C "$project" checkout --quiet "$default"; then
                printf '%s: could not check out %s; skip deleting %s\n' \
                    "$name" "$default" "$branch" >&2
                failed=$((failed + 1))
                continue
            fi
            printf '%s: checked out %s\n' "$name" "$default"
            current=$default
        fi
        if git -C "$project" branch -D -- "$branch" >/dev/null; then
            printf 'deleted branch %s %s\n' "$name" "$branch"
            removed_br=$((removed_br + 1))
        else
            printf 'failed to delete branch %s %s\n' "$name" "$branch" >&2
            failed=$((failed + 1))
        fi
    done <<EOF
$(local_branches)
EOF

    while IFS= read -r branch; do
        [ -n "$branch" ] || continue
        if git -C "$project" branch -dr -- "$branch" >/dev/null; then
            printf 'deleted remote-tracking branch %s %s\n' "$name" "$branch"
            removed_remote=$((removed_remote + 1))
        else
            printf 'failed to delete remote-tracking branch %s %s\n' "$name" "$branch" >&2
            failed=$((failed + 1))
        fi
    done <<EOF
$(remote_branches)
EOF
done

printf 'removed %s worktree(s), deleted %s branch(es), deleted %s remote-tracking branch(es)\n' \
    "$removed_wt" "$removed_br" "$removed_remote"

if [ "$failed" -ne 0 ]; then
    exit 1
fi
